// QuizResultModal.js
import React from "react";
import { Bar } from "react-chartjs-2"; // za grafikon

export default function QuizResultModal({ result, onClose }) {
  if (!result) return null;

  // priprema podataka za grafikon (procenti po pokušaju)
  const chartData = {
    labels: result.attempts?.map((a, i) => `Pokušaj ${i + 1}`) || ["Pokušaj 1"],
    datasets: [
      {
        label: "% tačnih odgovora",
        data: result.attempts?.map(a => a.percentage) || [result.percentage],
        backgroundColor: "rgba(75,192,192,0.6)"
      }
    ]
  };

  return (
    <div style={{
      position: "fixed", top: 0, left: 0, right: 0, bottom: 0,
      background: "rgba(0,0,0,0.5)",
      display: "flex", alignItems: "center", justifyContent: "center"
    }}>
      <div style={{ background: "#fff", padding: 20, borderRadius: 8, width: 700, maxHeight: "80vh", overflowY: "auto" }}>
        <h2>Rezultat kviza</h2>
        <p>Poeni: {result.score} / {result.totalQuestions} ({result.percentage}%)</p>
        <p>Vreme trajanja: {Math.floor(result.duration / 60)} min {result.duration % 60} sek</p>

        <h3>Pitanja i odgovori</h3>
        {result.questionResults.map(q => (
          <div key={q.id} style={{ marginBottom: 12, padding: 10, border: "1px solid #eee", borderRadius: 6 }}>
            <p><strong>{q.text}</strong> ({q.isCorrect ? "Tačno" : "Netačno"})</p>
            <ul>
              {q.answers.map(a => (
                <li key={a.id} style={{ fontWeight: q.userAnswerIds.includes(a.id) ? "bold" : "normal" }}>
                  {a.text} {a.isCorrect ? "(Tačan odgovor)" : ""}
                </li>
              ))}
            </ul>
            {q.type === "FillInTheBlank" && <p>Vaš odgovor: {q.userTextAnswer}</p>}
          </div>
        ))}

        <h3>Napredak kroz pokušaje</h3>
        <div style={{ maxWidth: "100%", marginBottom: 10 }}>
          <Bar data={chartData} options={{ responsive: true, scales: { y: { beginAtZero: true, max: 100 } } }} />
        </div>

        <button onClick={onClose} style={{ marginTop: 10, padding: "6px 12px" }}>Zatvori</button>
      </div>
    </div>
  );
}
